{
  "name": "super-duper-eureka",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "retirement-calc": "bun run packages/cli/src/index.ts",
    "test": "bun run --parallel --filter '!e2e' test",
    "lint": "vp lint",
    "format": "vp fmt",
    "build": "bun run --parallel --filter '*' build",
    "dev": "bun run  --elide-lines 0 --parallel --filter '*' dev",
    "e2e": "bun run --filter e2e test",
    "e2e:debugger": "bun run --filter e2e test:debugger",
    "e2e:ui": "bun run --filter e2e test:ui"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@types/bun": "latest",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.5",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0",
    "vite-plus": "1.7.0",
    "@vitest/coverage-v8": "5.1.0"
  }
}
